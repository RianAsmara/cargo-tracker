# ==========================================
# DATABASE SETTINGS
# ==========================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cargo_tracker

# Backend resolves this internally if DB_USER/DB_PASSWORD/DB_NAME are not passed explicitly
# DB_URL=postgres://postgres:postgres@db:5432/cargo_tracker?sslmode=disable 

# ==========================================
# CACHE & QUEUE SETTINGS
# ==========================================
REDIS_URL=redis:6379

# ==========================================
# BACKEND SETTINGS
# ==========================================
# Base port the Go server runs on
PORT=8080
# Critical: Ensure this is a strong cryptographically generated secret in production
JWT_SECRET=supersecretkey_change_me_in_production

# ==========================================
# FRONTEND SETTINGS
# ==========================================
# This determines what API URL the client-side browsers and SPA will fetch against
NEXT_PUBLIC_API_URL=http://localhost:8099
# The internal network URL used by the SSR NextJS process to talk directly to Go backend avoiding public routers
API_INTERNAL_URL=http://backend:8080
